// ============================================================================
// Grafana Alloy - UM Linux host -> Loki on the central Windows box.
// Runs on EACH of the 4 UM hosts (um1, um2, um3, um4).
//
// PER HOST, edit:
//   (1) loki.write url  -> your Windows box
//   (2) the host label  -> um1|um2|um3|um4 (match prometheus.yml for THIS host)
//   (3) the log path globs + realm name
// Then: sudo systemctl restart alloy
// ============================================================================

logging {
  level  = "info"
  format = "logfmt"
}

loki.write "default" {
  endpoint {
    url = "http://WINDOWS-HOST:3100/loki/api/v1/push"   // <-- your central Windows box IP/name
  }
}

// Universal Messaging realm logs (nirvana.log etc.)
local.file_match "um" {
  path_targets = [
    { __path__ = "/opt/softwareag/UniversalMessaging/server/umserver/data/*.log", component = "universal-messaging", host = "um1", logset = "um" },
  ]
}
loki.source.file "um" {
  targets    = local.file_match.um.targets
  forward_to = [loki.process.wm.receiver]
}

// JVM wrapper log (start / OOM / crash / restart)
local.file_match "wrapper" {
  path_targets = [
    { __path__ = "/opt/softwareag/UniversalMessaging/server/umserver/bin/wrapper.log", component = "universal-messaging", host = "um1", logset = "wrapper" },
  ]
}
loki.source.file "wrapper" {
  targets    = local.file_match.wrapper.targets
  forward_to = [loki.process.wm.receiver]
}

// Promote the severity word to a `level` label
loki.process "wm" {
  stage.regex {
    expression = "(?i)(?P<level>FATAL|ERROR|WARN|WARNING|INFO|DEBUG|TRACE)"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.default.receiver]
}
