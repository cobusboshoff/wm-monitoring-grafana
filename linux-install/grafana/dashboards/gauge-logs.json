      }
    },
    {
      "type": "row",
      "title": "Universal Messaging logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "logs",
      "title": "UM realm logs",
      "gridPos": {
        "h": 9,
