        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{component=\"universal-messaging\", logset=\"um\"} |~ \"(?i)$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
