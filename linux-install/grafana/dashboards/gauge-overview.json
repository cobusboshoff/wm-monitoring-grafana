              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "displayName": "IS"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
